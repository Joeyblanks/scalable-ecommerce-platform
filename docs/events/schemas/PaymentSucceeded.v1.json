{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Joeyblanks/scalable-ecommerce-platform/docs/events/schemas/PaymentSucceeded.v1.json",
  "title": "PaymentSucceeded v1",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "producer",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "PaymentSucceeded"
    },
    "eventVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "const": "payment-service"
    },
    "data": {
      "type": "object",
      "required": [
        "paymentId",
        "orderId",
        "amount",
        "succeededAt"
      ],
      "properties": {
        "paymentId": {
          "type": "string"
        },
        "orderId": {
          "type": "string",
          "format": "uuid"
        },
        "amount": {
          "type": "string",
          "pattern": "^-?[0-9]+\\.[0-9]{2}$",
          "description": "decimal string with 2 places"
        },
        "succeededAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
