# Copy to .env (gitignored) and fill in. Never commit real secrets or keys.
USER_DB_USERNAME=user_service
USER_DB_PASSWORD=change-me

# RS256 private key for signing JWTs: base64 of an unencrypted PKCS#8 PEM, on ONE line.
# Generate it once and keep it stable (a new key invalidates all issued tokens):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 | tr -d '\n'
# This placeholder is intentionally invalid: the service refuses to start until replaced.
JWT_PRIVATE_KEY=replace-with-output-of-the-openssl-command-above

# Optional: create the first ADMIN at startup. Set BOTH or neither (no defaults).
# Password: 12-72 characters. Use a strong unique value.
#BOOTSTRAP_ADMIN_EMAIL=admin@example.com
#BOOTSTRAP_ADMIN_PASSWORD=
