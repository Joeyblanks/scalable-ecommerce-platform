# Copy to .env (gitignored) and fill in. Never commit real secrets or keys.
USER_DB_USERNAME=user_service
USER_DB_PASSWORD=change-me
CATALOG_DB_USERNAME=catalog_service
CATALOG_DB_PASSWORD=change-me
# Host port for the catalog database (change it if 5434 is taken on your machine)
CATALOG_DB_PORT=5434

# RS256 private key for signing JWTs: base64 of an unencrypted PKCS#8 PEM, on ONE line.
# Generate it once and keep it stable (a new key invalidates all issued tokens):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 | tr -d '\n'
# This placeholder is intentionally invalid: the service refuses to start until replaced.
JWT_PRIVATE_KEY=replace-with-output-of-the-openssl-command-above

# Optional: create the first ADMIN at startup. Set BOTH or neither (no defaults).
# Password: 12-72 characters. Use a strong unique value.
#BOOTSTRAP_ADMIN_EMAIL=admin@example.com
#BOOTSTRAP_ADMIN_PASSWORD=

# Service-to-service tokens (see README "Service tokens"). user-service stores only the bcrypt
# HASH of each client secret; leave it unset to disable that client.
#   docker run --rm httpd:2.4-alpine htpasswd -nbBC 12 "" '<the secret>' | tr -d ':\n'
#ORDER_SERVICE_CLIENT_SECRET_HASH=
# The matching plain secret, for order-service only (needed to place orders).
#ORDER_SERVICE_CLIENT_SECRET=
# notification-service looks up customers' email addresses (same recipe: hash here, plain secret there).
#NOTIFICATION_SERVICE_CLIENT_SECRET_HASH=
#NOTIFICATION_SERVICE_CLIENT_SECRET=

ORDER_DB_USERNAME=order_service
ORDER_DB_PASSWORD=change-me
# Host port for the order database (change it if 5435 is taken on your machine)
ORDER_DB_PORT=5435

PAYMENT_DB_USERNAME=payment_service
PAYMENT_DB_PASSWORD=change-me
# Host port for the payment database (change it if 5436 is taken on your machine)
PAYMENT_DB_PORT=5436

# Optional: charge through Stripe TEST mode instead of the built-in simulated provider.
# Use a TEST key only (sk_test_... or rk_test_...); the service refuses to start with a live key.
# Keep it in .env (gitignored), never in a file that is committed. PAYMENT_PROVIDER=simulated forces the
# simulated provider even when a key is set.
#STRIPE_API_KEY=
#PAYMENT_PROVIDER=auto

NOTIFICATION_DB_USERNAME=notification_service
NOTIFICATION_DB_PASSWORD=change-me
# Host port for the notification database (change it if 5437 is taken on your machine)
NOTIFICATION_DB_PORT=5437

# Emails are caught by Mailpit and shown at http://localhost:8025 (nothing is really sent).
MAILPIT_UI_PORT=8025
#MAIL_FROM=orders@shop.local

RABBITMQ_USERNAME=ecommerce
RABBITMQ_PASSWORD=change-me
# RabbitMQ management UI: http://localhost:15672
RABBITMQ_UI_PORT=15672
